{
  "name": "pierology",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.mjs",
    "start": "node server.mjs",
    "build": "node scripts/build.mjs",
    "deploy": "npm run build && wrangler deploy",
    "deploy:check": "npm run build && wrangler deploy --dry-run",
    "check": "node --check app.js && node --check content.js && node --check server.mjs && node --check scripts/build.mjs",
    "test": "node scripts/check-site.mjs"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "wrangler": "4.141.0"
  }
}
